{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=agapay_db;Username=postgres;Password=YOUR_SECURE_PASSWORD"
  },
  "Jwt": {
    "Issuer": "https://your-api.example.com",
    "Audience": "agapay-mobile",
    "Key": "YOUR_LONG_RANDOM_SECRET"
  },
  "Supabase": {
    "Url": "https://YOUR-PROJECT.supabase.co",
    "ServiceRoleKey": "YOUR_SERVICE_ROLE_KEY",
    "Bucket": "YOUR_BUCKET"
  },
  "Mailjet": {
    "ApiKey": "YOUR_MAILJET_API_KEY",
    "ApiSecret": "YOUR_MAILJET_API_SECRET",
    "SenderEmail": "no-reply@yourdomain.com"
  },
  "Otp": {
    "ExpiryMinutes": 10,
    "LogToConsoleInDev": true,
    "TrustedDeviceDays": 30
  },
  "Seed": {
    "AdminPassword": "YOUR_SEED_ADMIN_PASSWORD",
    "BypassOtpForDemoAccounts": true
  },
  "MigrateOnStartup": true
}
